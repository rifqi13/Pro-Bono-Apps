#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false   # true di production
app.indexPage = ''
app.uriProtocol = 'REQUEST_URI'

#--------------------------------------------------------------------
# TIMEZONE & LOCALE
#--------------------------------------------------------------------
app.defaultTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'
app.supportedLocales = 'en,id'

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie'
security.expires = 7200
security.regenerate = false
security.redirect = 'cookie'
security.samesite = 'Strict'

# App Encryption Key — generate dengan: php spark key:generate
encryption.key = hex2bin:65023f4dbadec126b56677bb9e0c3dcd31e6001603ab3893ff237c20f16ca6b0
encryption.driver = 'OpenSSL'
encryption.cipher = 'AES-256-GCM'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.cookieName = 'peradi_session'
session.expiration = 7200
session.savePath = 'ci_sessions'
session.matchIP = true
session.timeToUpdate = 300
session.regenerateDestroy = true
session.secure = false          # true di production (HTTPS)

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = probono_a
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.strictOn = true

#--------------------------------------------------------------------
# EMAIL (dev: Mailtrap)
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = mail.peradi.or.id
email.SMTPUser = YOUR_MAILTRAP_USER
email.SMTPPass = YOUR_MAILTRAP_PASS
email.SMTPPort = 2525
email.SMTPCrypto = tls
email.fromEmail = pbh@peradi.or.id
email.fromName = 'PERADI Pro Bono'
email.mailType = 'html'

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------
upload.maxSize = 5120            # 5 MB
upload.allowedExt = 'pdf,jpg,jpeg,png'
# upload.uploadPath = WRITEPATH . 'uploads/'

#--------------------------------------------------------------------
# RATE LIMIT
#--------------------------------------------------------------------
ratelimit.login.max = 5
ratelimit.login.decay = 1        # menit
ratelimit.register.max = 3
ratelimit.register.decay = 60
ratelimit.forgot.max = 3
ratelimit.forgot.decay = 60

#--------------------------------------------------------------------
# RECAPTCHA (opsional)
#--------------------------------------------------------------------
recaptcha.siteKey = YOUR_SITE_KEY
recaptcha.secretKey = YOUR_SECRET_KEY
recaptcha.enabled = false

#--------------------------------------------------------------------
# LOGIN ATTEMPT
#--------------------------------------------------------------------
login.lockout.maxAttemptsPerIp = 5
login.lockout.windowIp = 15      # menit
login.lockout.maxAttemptsPerEmail = 10
login.lockout.windowEmail = 60   # menit
login.lockout.duration = 30      # menit
login.alert.emailTo = 'admin@peradi.or.id'

#--------------------------------------------------------------------
# NIA VALIDATION
#--------------------------------------------------------------------
nia.format = '/^[A-Z]{2}\d{5,10}$/'   # sesuaikan format NIA PERADI
nia.checkMasterDb = true
nia.checkExternalApi = false
nia.externalApiUrl = ''
nia.externalApiKey = ''

